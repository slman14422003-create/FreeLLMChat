    {
      "id": "ollama",
      "name": "Ollama (محلي / LAN)",
      "baseUrl": "",
      "keyUrl": "",
      "available": true,
      "keyless": true,
      "custom": true,
      "steps": [
        "ثبّت Ollama على حاسوبك وحمّل مودلاً مثل: ollama pull llama3.2",
        "على الحاسوب اضبط OLLAMA_HOST=0.0.0.0 ثم أعد تشغيل Ollama حتى يقبل اتصالات الشبكة.",
        "اسمح بالمنفذ 11434 في جدار الحماية (Firewall) للشبكة الخاصة فقط.",
        "اكتب العنوان مثل http://192.168.1.10:11434/v1 ثم اضغط اختبار الاتصال.",
        "اضغط اكتشاف المودلات واختر المودلات، ثم اضغط اختبر المفتاح للحفظ."
      ],
      "warnings": [
        "بلا مفتاح وبلا حد يومي؛ السرعة تعتمد على جهازك.",
        "http مسموح فقط لعناوين الشبكة المحلية (192.168.x.x و10.x.x.x و172.16-31.x.x وlocalhost).",
        "الهاتف والحاسوب يجب أن يكونا على نفس الشبكة."
      ]
    }
