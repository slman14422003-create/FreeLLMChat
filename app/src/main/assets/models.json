{
  "version": 3,
  "providers": [
    {
      "id": "gemini",
      "name": "Google Gemini",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "keyUrl": "https://aistudio.google.com/app/apikey",
      "available": true,
      "steps": [
        "افتح صفحة المفاتيح بالزر أدناه.",
        "سجّل الدخول بحساب Google.",
        "اضغط Create API key واختر مشروعاً أو أنشئ مشروعاً جديداً.",
        "انسخ المفتاح.",
        "ألصقه في الحقل أدناه ثم اضغط اختبر المفتاح."
      ],
      "warnings": [
        "لا يطلب بطاقة ولا رقم هاتف عادةً.",
        "غير متاح في بعض الدول.",
        "في الباقة المجانية قد تُستخدم محادثاتك لتحسين منتجات Google.",
        "الحد المجاني تقريباً: من عشرات إلى مئات الطلبات يومياً حسب المودل."
      ]
    },
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "keyUrl": "https://openrouter.ai/settings/keys",
      "available": true,
      "perModelLimits": true,
      "headers": {
        "X-Title": "FreeLLM Chat"
      },
      "steps": [
        "افتح صفحة المفاتيح بالزر أدناه.",
        "سجّل الدخول بحساب Google أو GitHub.",
        "اضغط Create Key وأعطه اسماً.",
        "انسخ المفتاح.",
        "ألصقه في الحقل أدناه ثم اضغط اختبر المفتاح."
      ],
      "warnings": [
        "لا يطلب بطاقة للمودلات المجانية (التي تنتهي بـ :free).",
        "الحد المجاني تقريباً: 20 طلباً في الدقيقة و50 طلباً يومياً، ويرتفع إلى 1000 يومياً بعد شحن 10 دولارات.",
        "بعض المودلات المجانية تسجّل المحادثات وقد تستخدمها للتدريب.",
        "المودلات المجانية تتغير وتختفي كثيراً."
      ]
    },
    {
      "id": "cloudflare",
      "name": "Cloudflare Workers AI",
      "baseUrl": "https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/v1",
      "keyUrl": "https://dash.cloudflare.com/profile/api-tokens",
      "available": true,
      "needsAccountId": true,
      "steps": [
        "افتح الصفحة بالزر أدناه وأنشئ API Token بقالب Workers AI.",
        "انسخ التوكن.",
        "انسخ Account ID من الصفحة الرئيسية للوحة Cloudflare.",
        "ألصق المفتاح وAccount ID في الحقول أدناه."
      ],
      "warnings": [
        "بدون بطاقة ولا هاتف.",
        "حصة مجانية يومية (10 آلاف Neuron) تتجدد منتصف الليل UTC.",
        "بعض النماذج الكبيرة تتطلب خطة مدفوعة ولن تعمل."
      ]
    },
    {
      "id": "cohere",
