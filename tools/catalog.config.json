{
  "awesomeNames": {
    "Google Gemini": "gemini",
    "OpenRouter": "openrouter",
    "Cloudflare Workers AI": "cloudflare",
    "Cohere": "cohere",
    "Z AI (Zhipu AI)": "zai",
    "Mistral AI": "mistral",
    "Groq": "groq",
    "NVIDIA NIM": "nvidia",
    "Kilo Code": "kilo",
    "OVHcloud AI Endpoints": "ovh",
    "LLM7.io": "llm7"
  },
  "prune": [
    "openrouter"
  ],
  "keep": [
    "openrouter/openrouter/free",
    "gemini/gemini-flash-latest",
    "gemini/gemini-2.5-pro"
  ],
  "autoAdopt": {
    "gemini": 3,
    "openrouter": 4,
    "mistral": 2,
    "groq": 2,
    "nvidia": 2,
    "kilo": 2,
    "ovh": 2,
    "llm7": 2,
    "cohere": 1,
    "zai": 0,
    "cloudflare": 3
  },
  "trainsOnData": [
    "gemini",
    "openrouter",
    "mistral",
    "kilo",
    "zai",
    "cohere"
  ],
  "limits": {
    "openrouter": {
      "rpm": 20
    },
    "cohere": {
      "rpm": 20,
      "rpmo": 1000
    }
  },
  "expires": {
    "gemini/gemini-3.1-flash-lite": "2027-05-07"
  },
  "skipIds": [
    "safety",
    "embed",
    "moderation",
    "guard"
  ],
  "providers": [
    {
      "id": "mistral",
      "name": "Mistral AI",
      "baseUrl": "https://api.mistral.ai/v1",
      "keyUrl": "https://console.mistral.ai/api-keys",
      "available": true,
      "steps": [
        "افتح صفحة المفاتيح بالزر أدناه.",
        "أنشئ حساباً أو سجّل الدخول (قد يُطلب تأكيد رقم هاتف).",
        "فعّل الوضع المجاني إن طُلب منك اختيار خطة.",
        "اضغط إنشاء مفتاح جديد ثم انسخه.",
        "ألصقه في الحقل أدناه ثم اضغط اختبر المفتاح."
      ],
      "warnings": [
        "لا يطلب بطاقة دفع.",
        "في الوضع المجاني قد تُستخدم محادثاتك لتدريب نماذج Mistral ما لم تُلغِ ذلك من إعدادات الحساب.",
        "الحد التقريبي: طلب واحد في الثانية."
      ],
      "sharedLimits": true
    },
    {
      "id": "groq",
      "name": "Groq",
      "baseUrl": "https://api.groq.com/openai/v1",
      "keyUrl": "https://console.groq.com/keys",
      "available": true,
      "steps": [
        "افتح صفحة المفاتيح بالزر أدناه.",
        "أنشئ حساباً أو سجّل الدخول.",
        "اضغط Create API Key وسمّه.",
        "انسخ المفتاح.",
        "ألصقه في الحقل أدناه ثم اضغط اختبر المفتاح."
      ],
      "warnings": [
        "لا يطلب بطاقة دفع.",
        "قد يرفض الطلبات (403) في بعض المناطق، والتطبيق يجرّب المسار البديل تلقائياً.",
        "الحد التقريبي: 30 طلباً في الدقيقة و1000 طلب يومياً لكل مودل."
      ],
      "perModelLimits": true
    },
    {
      "id": "nvidia",
      "name": "NVIDIA NIM",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "keyUrl": "https://build.nvidia.com/explore/discover",
      "available": true,
      "steps": [
        "افتح صفحة المودلات بالزر أدناه.",
        "سجّل الدخول بحساب NVIDIA أو أنشئ حساباً.",
        "اختر أي مودل ثم اضغط Get API Key.",
        "انسخ المفتاح (يبدأ بـ nvapi-).",
        "ألصقه في الحقل أدناه ثم اضغط اختبر المفتاح."
      ],
      "warnings": [
        "يتطلب عضوية NVIDIA Developer Program وقد يُطلب تأكيد رقم هاتف.",
        "الحد التقريبي: 40 طلباً في الدقيقة."
      ],
      "sharedLimits": true
    },
    {
      "id": "kilo",
      "name": "Kilo Gateway (بلا مفتاح)",
      "baseUrl": "https://api.kilo.ai/api/gateway",
      "keyUrl": "",
      "available": true,
      "steps": [
        "لا يحتاج أي مفتاح، يعمل مباشرة بعد التثبيت.",
        "يمكنك تفعيله أو تعطيله من المفتاح الجانبي في قائمة المزودين.",
        "اضغط اختبار الاتصال للتأكد."
      ],
      "warnings": [
        "الحد التقريبي: 200 طلب في الساعة لكل عنوان IP.",
        "مودلات المجمع المجاني تتغير باستمرار، راجع سياسة الخصوصية قبل إرسال بيانات حساسة."
      ],
      "keyless": true,
      "sharedLimits": true
    },
    {
      "id": "ovh",
      "name": "OVHcloud (بلا مفتاح)",
      "baseUrl": "https://oai.endpoints.kepler.ai.cloud.ovh.net/v1",
      "keyUrl": "",
      "available": true,
      "steps": [
        "لا يحتاج أي مفتاح ولا تسجيل.",
        "يمكنك تفعيله أو تعطيله من المفتاح الجانبي في قائمة المزودين.",
        "اضغط اختبار الاتصال للتأكد."
      ],
      "warnings": [
        "الحد: طلبان في الدقيقة لكل عنوان IP ولكل مودل.",
        "المودلات مستضافة في أوروبا."
      ],
      "keyless": true,
      "perModelLimits": true
    },
    {
      "id": "llm7",
      "name": "LLM7 (مفتاح اختياري)",
      "baseUrl": "https://api.llm7.io/v1",
      "keyUrl": "https://token.llm7.io",
      "available": true,
      "steps": [
        "يعمل بدون مفتاح بحدود منخفضة.",
        "لرفع الحدود افتح صفحة التوكن بالزر أدناه وسجّل للحصول على توكن مجاني.",
        "ألصق التوكن في الحقل أدناه (اختياري) ثم اضغط اختبر."
      ],
      "warnings": [
        "الحد مع التوكن: 60 طلباً في الدقيقة و250 طلباً في الساعة.",
        "قد تتغير الموديلات أو تختفي دون إشعار."
      ],
      "keyless": true,
      "sharedLimits": true
    },
    {
      "id": "openrouter",
      "sharedLimits": true
    }
  ],
