{
  "awesomeNames": {
    "Google Gemini": "gemini",
    "OpenRouter": "openrouter",
    "Cloudflare Workers AI": "cloudflare",
    "Cohere": "cohere",
    "Z AI (Zhipu AI)": "zai",
    "Groq": "groq",
    "Kilo Code": "kilo",
    "OVHcloud AI Endpoints": "ovh",
    "LLM7.io": "llm7"
  },
  "prune": [
    "openrouter"
  ],
  "keep": [
    "openrouter/openrouter/free",
    "gemini/gemini-flash-latest",
    "gemini/gemini-2.5-pro"
  ],
  "autoAdopt": {
    "gemini": 3,
    "openrouter": 4,
    "groq": 2,
    "kilo": 2,
    "ovh": 2,
    "llm7": 2,
    "cohere": 1,
    "zai": 0,
    "cloudflare": 3,
    "github": 3
  },
  "trainsOnData": [
    "gemini",
    "openrouter",
    "kilo",
    "zai",
    "cohere"
  ],
  "limits": {
    "openrouter": {
      "rpm": 20
    },
    "cohere": {
      "rpm": 20,
      "rpmo": 1000
    }
  },
  "expires": {
    "gemini/gemini-3.1-flash-lite": "2027-05-07"
  },
  "skipIds": [
    "safety",
    "embed",
    "moderation",
    "guard"
  ],
  "providers": [
    {
      "id": "groq",
      "name": "Groq",
      "baseUrl": "https://api.groq.com/openai/v1",
      "keyUrl": "https://console.groq.com/keys",
      "available": true,
      "steps": [
        "افتح صفحة المفاتيح بالزر أدناه.",
        "أنشئ حساباً أو سجّل الدخول.",
        "اضغط Create API Key وسمّه.",
        "انسخ المفتاح.",
        "ألصقه في الحقل أدناه ثم اضغط اختبر المفتاح."
      ],
      "warnings": [
        "لا يطلب بطاقة دفع.",
        "قد يرفض الطلبات (403) في بعض المناطق، والتطبيق يجرّب المسار البديل تلقائياً.",
        "الحد التقريبي: 30 طلباً في الدقيقة و1000 طلب يومياً لكل مودل."
      ],
      "perModelLimits": true
    },
    {
      "id": "kilo",
      "name": "Kilo Gateway (بلا مفتاح)",
      "baseUrl": "https://api.kilo.ai/api/gateway",
      "keyUrl": "",
      "available": true,
      "steps": [
        "لا يحتاج أي مفتاح، يعمل مباشرة بعد التثبيت.",
        "يمكنك تفعيله أو تعطيله من المفتاح الجانبي في قائمة المزودين.",
        "اضغط اختبار الاتصال للتأكد."
      ],
      "warnings": [
        "الحد التقريبي: 200 طلب في الساعة لكل عنوان IP.",
        "مودلات المجمع المجاني تتغير باستمرار، راجع سياسة الخصوصية قبل إرسال بيانات حساسة."
      ],
      "keyless": true,
      "sharedLimits": true
    },
    {
      "id": "ovh",
      "name": "OVHcloud (بلا مفتاح)",
      "baseUrl": "https://oai.endpoints.kepler.ai.cloud.ovh.net/v1",
      "keyUrl": "",
      "available": true,
      "steps": [
        "لا يحتاج أي مفتاح ولا تسجيل.",
        "يمكنك تفعيله أو تعطيله من المفتاح الجانبي في قائمة المزودين.",
        "اضغط اختبار الاتصال للتأكد."
      ],
      "warnings": [
        "الحد: طلبان في الدقيقة لكل عنوان IP ولكل مودل.",
        "المودلات مستضافة في أوروبا."
      ],
      "keyless": true,
      "perModelLimits": true
    },
    {
      "id": "llm7",
      "name": "LLM7 (مفتاح اختياري)",
      "baseUrl": "https://api.llm7.io/v1",
      "keyUrl": "https://token.llm7.io",
      "available": true,
      "steps": [
        "يعمل بدون مفتاح بحدود منخفضة.",
        "لرفع الحدود افتح صفحة التوكن بالزر أدناه وسجّل للحصول على توكن مجاني.",
        "ألصق التوكن في الحقل أدناه (اختياري) ثم اضغط اختبر."
      ],
      "warnings": [
        "الحد مع التوكن: 60 طلباً في الدقيقة و250 طلباً في الساعة.",
        "قد تتغير الموديلات أو تختفي دون إشعار."
      ],
      "keyless": true,
      "sharedLimits": true
    },
    {
      "id": "openrouter",
      "sharedLimits": true
    },
    {
      "id": "github",
      "name": "GitHub Models",
      "baseUrl": "https://models.github.ai/inference",
      "keyUrl": "https://github.com/settings/personal-access-tokens/new",
      "available": true,
      "perModelLimits": true,
      "steps": [
        "افتح صفحة إنشاء التوكن بالزر أدناه وسجّل الدخول إلى GitHub.",
        "أعطِ التوكن اسماً (Fine-grained personal access token) واختر مدة انتهاء قصيرة.",
        "في قسم Permissions ← Account permissions اختر Models: Read-only.",
        "اضغط Generate token وانسخ التوكن.",
        "ألصقه في الحقل أدناه ثم اضغط اختبر المفتاح."
      ],
      "warnings": [
        "مجاني بحدود يومية ودقيقية تختلف حسب المودل وخطة حسابك؛ راجع توثيق GitHub Models الرسمي للأرقام الحالية.",
        "حجم الطلب والرد محدود في الباقة المجانية، لذلك يستخدم التطبيق نافذة سياق صغيرة معهم.",
        "تُرسل محادثاتك إلى GitHub ومطوّر المودل؛ راجع شروط GitHub Models قبل إرسال بيانات حساسة.",
        "لا تمنح التوكن أي صلاحية غير Models: Read."
      ]
    },
    {
      "id": "custom",
      "name": "مزود مخصّص (Ollama / LM Studio)",
      "baseUrl": "",
      "keyUrl": "",
      "available": true,
      "keyless": true,
      "custom": true,
      "steps": [
        "شغّل خادماً متوافقاً مع OpenAI على شبكتك أو على الإنترنت (Ollama أو LM Studio أو أي بوابة).",
        "اكتب عنوان الخادم الأساسي مثل http://192.168.1.10:11434/v1 في حقل العنوان.",
        "اكتب اسم المودل كما يظهر في الخادم تماماً.",
        "اترك المفتاح فارغاً إن لم يكن مطلوباً ثم اضغط اختبر."
      ],
      "warnings": [
        "الاتصال بهذا المزود مباشر ولا يمر عبر الـWorker.",
        "استخدم http فقط على شبكة تثق بها."
      ]
    },
    {
      "id": "ollama",
      "name": "Ollama (محلي / LAN)",
      "baseUrl": "",
      "keyUrl": "",
      "available": true,
      "keyless": true,
      "custom": true,
      "steps": [
        "ثبّت Ollama على حاسوبك وحمّل مودلاً مثل: ollama pull llama3.2",
        "على الحاسوب اضبط OLLAMA_HOST=0.0.0.0 ثم أعد تشغيل Ollama حتى يقبل اتصالات الشبكة.",
        "اسمح بالمنفذ 11434 في جدار الحماية (Firewall) للشبكة الخاصة فقط.",
        "اكتب العنوان مثل http://192.168.1.10:11434/v1 ثم اضغط اختبار الاتصال.",
        "اضغط اكتشاف المودلات واختر المودلات، ثم اضغط اختبر المفتاح للحفظ."
      ],
      "warnings": [
        "بلا مفتاح وبلا حد يومي؛ السرعة تعتمد على جهازك.",
        "http مسموح فقط لعناوين الشبكة المحلية (192.168.x.x و10.x.x.x و172.16-31.x.x وlocalhost).",
        "الهاتف والحاسوب يجب أن يكونا على نفس الشبكة."
      ]
    }
  ],
